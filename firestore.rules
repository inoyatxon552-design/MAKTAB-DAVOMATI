rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Maktab davomati: har bir foydalanuvchi faqat o'z ma'lumotini o'qiydi va yozadi
    match /schools/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
